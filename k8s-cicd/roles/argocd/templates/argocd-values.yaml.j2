# {{ ansible_managed }}
global:
  domain: {{ argocd_host }}

configs:
  params:
    # TLS kết thúc ở Traefik (hoặc chạy http nội bộ) -> argocd-server chạy http
    server.insecure: true
  cm:
    # Kiểm tra repo Git mỗi 60 giây (mặc định 180s)
    timeout.reconciliation: 60s

server:
  ingress:
    enabled: true
    ingressClassName: traefik
    hostname: {{ argocd_host }}

# Không dùng SSO -> tắt Dex cho nhẹ
dex:
  enabled: false
