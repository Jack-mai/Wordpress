# {{ ansible_managed }}
# https://{{ ingress_ip }}{{ argocd_path }} -> argocd-server
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd
  namespace: argocd
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: {{ argocd_path }}
            pathType: Prefix
            backend:
              service:
                name: argocd-server
                port:
                  number: 80
