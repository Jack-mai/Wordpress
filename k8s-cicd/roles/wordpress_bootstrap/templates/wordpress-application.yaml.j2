# {{ ansible_managed }}
# Argo CD deploy Helm chart WordPress từ repo Git, giữ cluster luôn giống Git
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: wordpress
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ gitops_repo_url }}
    targetRevision: {{ gitops_repo_branch }}
    path: {{ gitops_path }}
    helm:
      releaseName: wordpress
      valueFiles:
        - {{ gitops_values_file }}
  destination:
    server: https://kubernetes.default.svc
    namespace: wordpress
  syncPolicy:
    automated:
      prune: true      # xóa resource đã bị xóa khỏi Git
      selfHeal: true   # sửa tay trên cluster sẽ bị đưa về đúng như Git
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
