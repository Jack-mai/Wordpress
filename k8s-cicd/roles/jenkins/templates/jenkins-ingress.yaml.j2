# {{ ansible_managed }}
# https://{{ ingress_ip }}{{ jenkins_path }} -> Jenkins
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: jenkins
  namespace: jenkins
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: {{ jenkins_path }}
            pathType: Prefix
            backend:
              service:
                name: jenkins
                port:
                  number: 8080
