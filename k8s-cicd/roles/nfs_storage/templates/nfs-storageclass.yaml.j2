# {{ ansible_managed }}
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ nfs_storageclass }}
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ nfs_server }}
  share: {{ nfs_share }}
  # Thư mục trên máy NFS đặt theo tên dễ đọc: <namespace>-<tên PVC>, vd wordpress-wordpress-uploads
  subDir: ${pvc.metadata.namespace}-${pvc.metadata.name}
# Retain: xóa PVC (lỡ tay, Argo CD prune...) KHÔNG xóa dữ liệu trên máy NFS
reclaimPolicy: Retain
volumeBindingMode: Immediate
allowVolumeExpansion: true
mountOptions:
  - nfsvers=4.1
  - hard
