# {{ ansible_managed }}
deployment:
  replicas: 2

ingressClass:
  enabled: true
  isDefaultClass: true

providers:
  kubernetesIngress:
    enabled: true
    # Cho Ingress hiện Address = IP của Traefik
    publishedService:
      enabled: true

# Mọi truy cập http:// tự chuyển sang https:// (khai báo bằng tham số Traefik: ổn định qua các bản chart)
additionalArguments:
  - "--entryPoints.web.http.redirections.entryPoint.to=websecure"
  - "--entryPoints.web.http.redirections.entryPoint.scheme=https"
  - "--entryPoints.web.http.redirections.entryPoint.permanent=true"

# Chứng chỉ mặc định cho mọi Ingress = chứng chỉ do CA nội bộ cấp cho {{ ingress_ip }}
tlsStore:
  default:
    defaultCertificate:
      secretName: {{ tls_secret_name }}

service:
  type: LoadBalancer
  annotations:
    metallb.io/loadBalancerIPs: "{{ ingress_ip }}"
  spec:
    # Giữ IP thật của client trong log
    externalTrafficPolicy: Local

# Rải 2 pod Traefik ra 2 node khác nhau
affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          topologyKey: kubernetes.io/hostname
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
