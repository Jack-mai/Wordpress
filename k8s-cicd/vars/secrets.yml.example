---
# Copy thành vars/secrets.yml rồi điền. KHÔNG commit file secrets.yml lên GitHub!
#   cp vars/secrets.yml.example vars/secrets.yml
#   ansible-vault encrypt vars/secrets.yml      # (khuyến nghị) mã hóa file
#
# GitHub Personal Access Token (classic): Settings > Developer settings > Tokens (classic)
# Quyền cần tick: repo, write:packages, read:packages
github_token: "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Mật khẩu admin Jenkins
jenkins_admin_password: "DoiMatKhauNay@123"

# Mật khẩu user wordpress trên MySQL (phải GIỐNG mysql_wordpress_password bên project data-server)
wordpress_db_password: "DoiMatKhauWP@123"
