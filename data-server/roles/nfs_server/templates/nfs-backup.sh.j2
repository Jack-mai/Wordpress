#!/bin/bash
# {{ ansible_managed }}
# Nén toàn bộ file share (uploads WordPress...) hằng đêm, giữ {{ nfs_backup_keep_days }} ngày
set -euo pipefail

FILE="{{ nfs_backup_dir }}/nfs-$(date +%Y%m%d-%H%M%S).tar.gz"
tar -C "{{ nfs_export_dir }}" -czf "$FILE.tmp" .
mv "$FILE.tmp" "$FILE"

find "{{ nfs_backup_dir }}" -name 'nfs-*.tar.gz' -mtime +{{ nfs_backup_keep_days }} -delete
echo "$(date '+%F %T') OK $FILE ($(du -h "$FILE" | cut -f1))"
